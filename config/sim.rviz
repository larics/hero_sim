Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Grid1
        - /Axes1
        - /TF1
        - /TF1/Frames1
        - /Map1
        - /Map2
        - /Map3
        - /Map4
        - /MarkerArray5
        - /MarkerArray5/Topic1
        - /MarkerArray5/Namespaces1
      Splitter Ratio: 0.5
    Tree Height: 437
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Expanded:
      - /2D Goal Pose1
      - /Publish Point1
    Name: Tool Properties
    Splitter Ratio: 0.5886790156364441
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Experimental: false
    Name: Time
    SyncMode: 0
    SyncSource: ""
